# ---- Supabase (https://supabase.com/dashboard -> Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- SAM.gov public API key (SAM.gov -> Account Details -> request public API key) ----
# Server-only. Fieldpoint never asks for a SAM.gov password.
SAM_API_KEY=
# Calls/day your key is allowed (docs do not state it; 10 is the conservative default for
# non-federal keys). Raise it if your SAM account role grants more.
SAM_DAILY_QUOTA=10
# Calls held back each day for on-demand description / attachment fetches.
SAM_RESERVED_CALLS=2

# ---- Anthropic (https://console.anthropic.com) ----
ANTHROPIC_API_KEY=
# Model names live in config, not code. Override per task if you like.
AI_MODEL_BRIEF=claude-opus-5-5
AI_MODEL_EXTRACT=claude-opus-5-5
AI_MODEL_SEARCH=claude-opus-5-5

# ---- Cron protection: send as header "Authorization: Bearer <CRON_SECRET>" ----
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Email digests (https://resend.com) ----
RESEND_API_KEY=
EMAIL_FROM="Fieldpoint <alerts@your-domain.com>"

# ---- App ----
APP_URL=http://localhost:3000

# ---- AI tuning ----
# Reasoning depth for briefs/extraction: low | medium | high | xhigh | max
AI_EFFORT=high
# on = ask the API to re-run a request on a fallback model if safety classifiers decline it
AI_REFUSAL_FALLBACK=on
